{
  "schema": 1,
  "id": "prologue",
  "name": "Prologue · 0th Chaos Lord",
  "bundle": false,
  "once": true,
  "notes": "The whole prologue in one run: 183, 176, 177, 178, 179 and 180 on the Swordhaven side, then 196 and 6216 for Gravelyn. It is a one-pass route (`once`), so a quest this character has handed in is remembered and never taken again, and the run stops itself once nothing is left; each pass works on whatever is already in hand, otherwise the furthest quest it can still accept, which is the order that keeps it off the first quest of the chain forever. A quest that was turned in is also recognised the way the quest log does it - a one-time quest whose slot counter has caught up - because a finished quest keeps a row and no status, exactly like an open one. Every entry step waits for the quest to be in hand as well as for the map, so a refused accept ends the run with a named step instead of farming a quest that never started. Two of the eight are not fights: 179 wants five knights spoken to and 6216 wants five gold piles clicked plus an Unlife Insurance Bond from shop 1559. For those the route stops combat, walks to the Blank cell and clicks the map item on a loop until the quest asks for nothing; 179 uses item 38, which is the id the map's own knight dialog sends, not the one older map revisions used. Combat is stopped again before every turn-in, and a farm step notices a finished quest on the tick it happens instead of at the next re-pull. Both loops are bounded by their retries. The bond is bought only if it is not already in the bag, and the packet goes straight down the wire because the client's own buy call opens a message box on any failed check and a bot cannot dismiss one. Loot is left alone on purpose: quest items arrive as temp items, and a decline rule that swallowed a normal drop would be one more way to break a story step.",
  "combat": {"target": "nearest", "rest": 60},
  "stop": [
    {"when": "bagFreeBelow", "value": 2, "say": "bag almost full"},
    {"when": "runFor", "value": 7200, "say": "two hours on this route"}
  ],
  "start": "route",
  "steps": [
    {
      "id": "route",
      "do": [
        {"act": "stopFight"},
        {"act": "quests", "ids": [183, 176, 177, 178, 179, 180, 196, 6216]}
      ],
      "wait": [{"when": "elapsed", "value": 3}],
      "timeout": 30,
      "retry": 3,
      "then": "pick"
    },
    {
      "id": "pick",
      "branch": [
        {"when": "questInHand", "id": 183, "then": "q183"},
        {"when": "questInHand", "id": 176, "then": "q176"},
        {"when": "questInHand", "id": 177, "then": "q177"},
        {"when": "questInHand", "id": 178, "then": "q178"},
        {"when": "questInHand", "id": 179, "then": "q179"},
        {"when": "questInHand", "id": 180, "then": "q180"},
        {"when": "questInHand", "id": 196, "then": "q196"},
        {"when": "questInHand", "id": 6216, "then": "q6216"},

        {"when": "questOffered", "id": 6216, "then": "q6216"},
        {"when": "questOffered", "id": 196, "then": "q196"},
        {"when": "questOffered", "id": 180, "then": "q180"},
        {"when": "questOffered", "id": 179, "then": "q179"},
        {"when": "questOffered", "id": 178, "then": "q178"},
        {"when": "questOffered", "id": 177, "then": "q177"},
        {"when": "questOffered", "id": 176, "then": "q176"},
        {"when": "questOffered", "id": 183, "then": "q183"}
      ],
      "else": "done"
    },
    {
      "id": "done",
      "do": [{"act": "stop", "msg": "prologue complete: nothing left to accept"}]
    },

    {
      "id": "q183",
      "branch": [{"when": "questComplete", "id": 183, "then": "q183-send"}],
      "do": [
        {"act": "acceptQuest", "id": 183},
        {"act": "join", "map": "portalundead", "cell": "Enter", "pad": "Right"}
      ],
      "wait": [
        {"when": "here", "map": "portalundead", "cell": "Enter"},
        {"when": "questInHand", "id": 183}
      ],
      "timeout": 30,
      "retry": 3,
      "then": "q183-farm"
    },
    {
      "id": "q183-farm",
      "branch": [{"when": "questComplete", "id": 183, "then": "q183-send"}],
      "do": [{"act": "aggro"}, {"act": "fight"}],
      "wait": [
        {"when": "any", "of": [
          {"when": "questComplete", "id": 183},
          {"when": "elapsed", "value": 15}
        ]}
      ],
      "timeout": 0,
      "then": "q183-farm"
    },
    {
      "id": "q183-send",
      "do": [
        {"act": "stopFight"},
        {"act": "completeQuest", "id": 183}
      ],
      "wait": [
        {"when": "not", "of": {"when": "questComplete", "id": 183}},
        {"when": "elapsed", "value": 2}
      ],
      "timeout": 20,
      "retry": 3,
      "then": "route"
    },

    {
      "id": "q176",
      "branch": [{"when": "questComplete", "id": 176, "then": "q176-send"}],
