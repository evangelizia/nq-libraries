{
  "schema": 1,
  "id": "prologue",
  "name": "Prologue · 0th Chaos Lord",
  "bundle": false,
  "notes": "The whole prologue in one run: 183, 176, 177, 178, 179 and 180 on the Swordhaven side, then 196 and 6216 for Gravelyn. Each pass asks the server for the eight quests and takes the first one it can still work on, so a run started halfway through picks up where the chain stands and a run with nothing left stops itself. A quest that was turned in is recognised the way the quest log does it - a one-time quest whose slot counter has caught up - because a finished quest keeps a row and no status, exactly like an open one. Every entry step waits for the quest to be in hand as well as for the map, so a refused accept ends the run with a named step instead of farming a quest that never started. Two of the eight are not fights: 179 wants five knights spoken to and 6216 wants five gold piles clicked plus an Unlife Insurance Bond from shop 1559, so those click their sparkle on a loop until the quest asks for nothing. Both loops are bounded by their retries. The bond is bought only if it is not already in the bag, and the packet goes straight down the wire because the client's own buy call opens a message box on any failed check and a bot cannot dismiss one. Loot is left alone on purpose: quest items arrive as temp items, and a decline rule that swallowed a normal drop would be one more way to break a story step.",
  "combat": {"target": "nearest", "rest": 60},
  "stop": [
    {"when": "bagFreeBelow", "value": 2, "say": "bag almost full"},
    {"when": "runFor", "value": 7200, "say": "two hours on this route"}
  ],
  "start": "route",
  "steps": [
    {
      "id": "route",
      "do": [{"act": "quests", "ids": [183, 176, 177, 178, 179, 180, 196, 6216]}],
      "wait": [{"when": "elapsed", "value": 2}],
      "timeout": 30,
      "retry": 3,
      "then": "pick"
    },
    {
      "id": "pick",
      "branch": [
        {"when": "questOffered", "id": 183, "then": "q183"},
        {"when": "questOffered", "id": 176, "then": "q176"},
        {"when": "questOffered", "id": 177, "then": "q177"},
        {"when": "questOffered", "id": 178, "then": "q178"},
        {"when": "questOffered", "id": 179, "then": "q179"},
        {"when": "questOffered", "id": 180, "then": "q180"},
        {"when": "questOffered", "id": 196, "then": "q196"},
        {"when": "questOffered", "id": 6216, "then": "q6216"}
      ],
      "else": "done"
    },
    {
      "id": "done",
      "do": [{"act": "stop", "msg": "prologue complete: nothing left to accept"}]
    },

    {
      "id": "q183",
      "branch": [{"when": "questComplete", "id": 183, "then": "q183-send"}],
      "do": [
        {"act": "acceptQuest", "id": 183},
        {"act": "join", "map": "portalundead", "cell": "Enter", "pad": "Right"}
      ],
      "wait": [
        {"when": "here", "map": "portalundead", "cell": "Enter"},
        {"when": "questActive", "id": 183}
      ],
      "timeout": 30,
      "retry": 3,
      "then": "q183-farm"
    },
    {
      "id": "q183-farm",
      "branch": [{"when": "questComplete", "id": 183, "then": "q183-send"}],
      "do": [{"act": "aggro"}, {"act": "fight"}],
      "wait": [{"when": "elapsed", "value": 15}],
      "timeout": 0,
      "then": "q183-farm"
    },
    {
      "id": "q183-send",
      "do": [{"act": "completeQuest", "id": 183}],
      "wait": [
        {"when": "not", "of": {"when": "questComplete", "id": 183}},
        {"when": "elapsed", "value": 2}
      ],
      "timeout": 20,
      "retry": 3,
      "then": "route"
    },

    {
      "id": "q176",
